{
  "name": "betterdraw",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts && node web/scripts/licenses.mjs && node web/scripts/compress.mjs",
    "start": "tsx server/index.ts",
    "check": "tsc -p server && tsc -p web && tsc -p packages",
    "format": "prettier --write server web/src web/vite.config.ts scripts",
    "test": "vitest --config packages/vitest.config.mts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.12",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-shape": "^3.2.0",
    "dotenv": "^16.6.1",
    "fractional-indexing": "3.2.0",
    "hono": "^4.13.13",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "playwright-core": "1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/chai": "4.3.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.4",
    "@types/d3-shape": "^3.1.6",
    "@types/jest": "27.4.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ansicolor": "2.0.3",
    "bun-types": "^1.4.4",
    "concurrently": "^9.0.0",
    "fake-indexeddb": "3.1.7",
    "jest-diff": "29.7.0",
    "jsdom": "22.1.0",
    "pepjs": "0.5.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "3.2.4",
    "vitest-canvas-mock": "0.3.3"
  },
  "prettier": {
    "printWidth": 140,
    "overrides": [
      {
        "files": [
          "*.md",
          "*.html"
        ],
        "options": {
          "requirePragma": true
        }
      }
    ]
  }
}

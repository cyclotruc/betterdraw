# Settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.prod and fill in. Never commit the filled file.
BASE_URL=https://draw.example.com
# Required: a long random password, for example from `openssl rand -hex 24`.
POSTGRES_PASSWORD=
SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:465
SMTP_FROM=betterdraw <hello@example.com>
# AUTH_SECRET=   # without it, a random secret is generated once and kept in the data volume
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# METRICS_TOKEN=
# What one person may own (0: no limit). Guests: 5 canvases and 10 MB; accounts: no canvas limit and 2000 MB.
# QUOTA_CANVASES_GUEST=5
# QUOTA_STORAGE_MB_GUEST=10
# QUOTA_CANVASES_USER=0
# QUOTA_STORAGE_MB_USER=2000
# GUEST_CANVAS_HOURS=24
# Images in a bucket instead of the data volume:
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Each nightly dump also uploaded to a bucket:
# BACKUP_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

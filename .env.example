# Copy to .env and uncomment what you change. Every setting is optional; docs/self-hosting.md lists them all.
# BASE_URL=http://localhost:3000
# PORT=3000
# DATA_DIR=./data                                   # the SQLite database, images and a generated secret
# DATABASE_URL=postgres://user:pass@localhost:5432/betterdraw   # without it, SQLite in DATA_DIR
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # without it, login links are printed in the server output
# SMTP_FROM="betterdraw <no-reply@example.com>"
# SIGNUP=open                                       # closed: no new accounts, guests make no canvases
# QUOTA_CANVASES_GUEST=5
# QUOTA_STORAGE_MB_GUEST=10
# GUEST_CANVAS_HOURS=24                             # 0: guests' canvases never expire
# CHROMIUM_PATH=                                    # a Chrome or Chromium binary, for agents' screenshots
